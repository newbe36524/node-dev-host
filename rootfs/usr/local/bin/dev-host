#!/usr/bin/env bash
# node-dev-host: Caddy + a source->dist build loop in one container.
#   dev-host run       (default) start Caddy and the build loop
#   dev-host rebuild   ask the running loop to rebuild now
#   dev-host status    print the last build status as JSON
#   dev-host control   start the control node (dashboard and API) instead of a project host
#                      (needs the Docker socket mounted; see README "Control node")
set -uo pipefail

# The variables as the operator set them, before the defaults below. The workspace configuration file
# (.node-dev-host.yaml) fills in the ones left empty here; see load_config.
ENV_INSTALL_CMD="${INSTALL_CMD:-}"
ENV_BUILD_CMD="${BUILD_CMD:-}"
ENV_DIST_DIR="${DIST_DIR:-}"
ENV_SPA="${SPA:-}"
ENV_API_UPSTREAM="${API_UPSTREAM:-}"

WORKSPACE="${WORKSPACE:-/workspace}"
DIST_DIR="${DIST_DIR:-dist}"
INSTALL_CMD="${INSTALL_CMD:-}"
BUILD_CMD="${BUILD_CMD:-pnpm build}"
POLL_INTERVAL="${POLL_INTERVAL:-2}"
# Build only after the tree has been quiet this long (a burst of saves gives one build).
DEBOUNCE_SECONDS="${DEBOUNCE_SECONDS:-3}"
# Wait at least this long after a build finishes before the next one.
MIN_BUILD_INTERVAL="${MIN_BUILD_INTERVAL:-10}"
# Build anyway when a change has been pending this long, even if edits never stop.
MAX_WAIT_SECONDS="${MAX_WAIT_SECONDS:-60}"
# Package registry for pnpm and npm, for example a local mirror. Empty keeps the registry from .npmrc or the defaults.
# pnpm reads PNPM_CONFIG_REGISTRY and npm reads npm_config_registry; both win over the workspace .npmrc.
NPM_REGISTRY="${NPM_REGISTRY:-}"
if [ -n "$NPM_REGISTRY" ]; then
  export PNPM_CONFIG_REGISTRY="$NPM_REGISTRY" npm_config_registry="$NPM_REGISTRY"
fi
HTTP_PORT="${HTTP_PORT:-8080}"
SPA="${SPA:-true}"
API_PATH="${API_PATH:-/api/*}"
API_UPSTREAM="${API_UPSTREAM:-}"
STATE_DIR="${STATE_DIR:-/var/lib/dev-host}"
# Install and build run in BUILD_DIR, a copy of WORKSPACE, so the mounted project is never written to.
BUILD_DIR="$STATE_DIR/build"
# Output of the last successful build. Caddy serves it, and a failed build never changes it.
SERVE_DIR="$STATE_DIR/www"
STATUS_FILE="$STATE_DIR/status.json"
TRIGGER_FILE="$STATE_DIR/rebuild"
# Read by Caddy on every request (X-Build-Time / X-Build-Duration headers).
BUILD_TIME_FILE="$STATE_DIR/build-time"
BUILD_DURATION_FILE="$STATE_DIR/build-duration"
# The configuration loader and the state files it writes into STATE_DIR (never into the workspace).
WS_CLI="$(dirname "${BASH_SOURCE[0]}")/../lib/dev-host/workspace-config.mjs"

# status.json fields that describe the workspace configuration, as a JSON fragment (values JSON-encoded).
NULL_META=',"name":null,"description":null,"configSource":null,"configHash":null,"configError":null,"ignore":[],"external":[]'
META_JSON="$NULL_META"
# Warnings of the current build, fixed texts; written as the "warnings" array of every status write.
WARNINGS=()
# Warnings from the attach step, already JSON-encoded strings (see workspace-config.mjs attach).
ATTACH_WARNINGS=()
# The effective settings, their rules and the change signature they were computed under.
RULES_KEY=""; RULES_IN_SIG=""; PREV_SIG=""
COPY_ARGS=(); PROTECT_ARGS=(); HASH_ARGS=(); DEPS_ARGS=()
RESOLVED_SPA=""; RESOLVED_API_UPSTREAM=""
# Set when the operator supplies CADDYFILE: then the serving settings from the file and environment are ignored.
CUSTOM_CADDYFILE=""

log() { printf '[dev-host %s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }

warnings_json() {
  local out="" w
  for w in "${WARNINGS[@]}"; do out="${out:+$out,}\"$w\""; done
  for w in "${ATTACH_WARNINGS[@]}"; do out="${out:+$out,}$w"; done
  printf '[%s]' "$out"
}

write_status() { # state, extra json fields (optional)
  local tmp="$STATUS_FILE.tmp"
  printf '{"state":"%s","builds":%d,"failures":%d,"lastExitCode":%s,"finishedAt":"%s"%s%s,"warnings":%s}\n' \
    "$1" "$BUILDS" "$FAILURES" "${LAST_EXIT:-null}" "$(date -u +%FT%TZ)" "${2:-}" "$META_JSON" "$(warnings_json)" > "$tmp" \
    && mv "$tmp" "$STATUS_FILE"
}

# rsync's own listing applies the rules, so the signature and the copy always agree on what is ignored. Each
# line is "size date time path" with the mode dropped: contents are not read, but size and mtime to the second
# (rsync's quick-check granularity) change the signature. Exit 24 (files vanished while listing) still gives a
# usable list; any other nonzero exit fails the signature, and the caller skips that poll.
list_sig() {
  local out rc=0
  out="$(rsync -r --list-only "$@" "$WORKSPACE/" 2>/dev/null)" || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 24 ]; then return 1; fi
  { printf '%s\n' "$out" | grep '^-' || true; } | sed 's/^[^ ]* *//' | sort | sha1sum | cut -d' ' -f1
}

# Hash of all source files; build output, tool caches and ignored paths are left out.
source_sig() { list_sig "${HASH_ARGS[@]}"; }

# Hash of the files that decide whether dependencies must be reinstalled.
deps_sig() { list_sig "${DEPS_ARGS[@]}"; }

write_caddyfile() {
  local root="$SERVE_DIR" file="$STATE_DIR/Caddyfile"
  {
    echo "{"
    echo "  admin off"
    echo "  auto_https off"
    echo "}"
    echo ":$HTTP_PORT {"
    echo "  encode zstd gzip"
    echo "  handle /__dev-host/status.json {"
    echo "    header Cache-Control no-store"
    echo "    rewrite * /status.json"
    echo "    root * $STATE_DIR"
    echo "    file_server"
    echo "  }"
    if [ -n "$API_UPSTREAM" ]; then
      # API_PATH lists one or more path matchers, separated by spaces or commas: "/api/* /grpc/* /hubs/*".
      local matcher="${API_PATH//,/ }"
      echo "  @api path $matcher"
      echo "  handle @api {"
      echo "    reverse_proxy $API_UPSTREAM"
      echo "  }"
    fi
    echo "  handle {"
    echo "    root * $root"
    [ "$SPA" = "true" ] && echo "    try_files {path} /index.html"
    echo "    header Cache-Control no-cache"
    echo "    header X-Build-Time \"{file.$BUILD_TIME_FILE}\""
    echo "    header X-Build-Duration \"{file.$BUILD_DURATION_FILE}\""
    echo "    file_server"
    echo "  }"
    echo "}"
  } > "$file"
}

# Reads .node-dev-host.yaml through workspace-config.mjs, which writes the effective settings, the status fields
# and the exclusion rules into STATE_DIR. Sets the build settings, META_JSON and the rules. Returns 0 when the
# file is valid or absent, 2 when it is rejected, 1 when the loader itself fails. A rejected file keeps the last
# valid ignore and external lists, so the change signature and the attach step do not move while the file is broken.
load_config() {
  local out rc=0 rules kind arg
  out="$(ENV_INSTALL_CMD="$ENV_INSTALL_CMD" ENV_BUILD_CMD="$ENV_BUILD_CMD" ENV_DIST_DIR="$ENV_DIST_DIR" \
    ENV_SPA="$ENV_SPA" ENV_API_UPSTREAM="$ENV_API_UPSTREAM" \
    node "$WS_CLI" load "$WORKSPACE" "$STATE_DIR" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ] && [ "$rc" -ne 2 ]; then
    log "workspace configuration could not be loaded (exit $rc): $out"
    META_JSON=',"name":null,"description":null,"configSource":null,"configHash":null,"configError":"workspace configuration could not be loaded","ignore":[],"external":[]'
    return 1
  fi
  [ -n "$out" ] && log "$out"
  . "$STATE_DIR/workspace-config.env" || return 1
  INSTALL_CMD="$WS_INSTALL_CMD"; BUILD_CMD="$WS_BUILD_CMD"; DIST_DIR="$WS_DIST_DIR"
  RESOLVED_SPA="$WS_SPA"; RESOLVED_API_UPSTREAM="$WS_API_UPSTREAM"
  META_JSON="$(cat "$STATE_DIR/workspace-config.status.json")"
  # The rules come from the same module as the status fields, so the copy, the hashes and the status never disagree.
  rules="$(node "$WS_CLI" rules "$DIST_DIR" "$STATE_DIR/workspace-config.ignore" "$STATE_DIR/workspace-config.external")" || return 1
  RULES_KEY="$rules"
  COPY_ARGS=(); PROTECT_ARGS=(); HASH_ARGS=(); DEPS_ARGS=()
  while IFS=$'\t' read -r kind arg; do
    case "$kind" in
      protect) PROTECT_ARGS+=("$arg") ;;
      copy) COPY_ARGS+=("$arg") ;;
      hash) HASH_ARGS+=("$arg") ;;
      deps) DEPS_ARGS+=("$arg") ;;
    esac
  done <<< "$rules"
  return "$rc"
}

# One rsync pass. Files outside the rules are copied; the protect rules keep node_modules, caches and the build
# output (and the output folder) in BUILD_DIR, and --delete-excluded removes a path that became ignored.
copy_source() {
  rsync -a --delete --delete-excluded "${PROTECT_ARGS[@]}" "${COPY_ARGS[@]}" "$WORKSPACE/" "$BUILD_DIR/"
}

# Copy WORKSPACE into BUILD_DIR. node_modules, caches and the build output are left out of the copy and
# protected from --delete, so they persist in BUILD_DIR between builds and never land in the workspace.
sync_source() {
  local rc=0
  mkdir -p "$BUILD_DIR" || return 1
  copy_source || rc=$?
  if [ "$rc" -eq 24 ]; then
    # Files changed while being copied, typically a tool still writing in the tree. One more copy gives a whole
    # tree or fails the build. The warning keeps the retry visible in status.json.
    WARNINGS+=("copy retried once: files changed while copying")
    log "copy: files vanished during the copy (exit 24), retrying once"
    rc=0; copy_source || rc=$?
  fi
  return "$rc"
}

# Attaches each external folder to BUILD_DIR as a link to its original in WORKSPACE. Runs after every copy, so a
# link removed or replaced by the copy is back before install and build. Skipped entries become ATTACH_WARNINGS
# (already JSON-encoded). Returns nonzero on any other failure, and the build then fails with the previous dist kept.
attach_external() {
  local out rc=0 line
  out="$(node "$WS_CLI" attach "$WORKSPACE" "$BUILD_DIR" "$STATE_DIR/workspace-config.external")" || rc=$?
  while IFS= read -r line; do
    [ -n "$line" ] && ATTACH_WARNINGS+=("$line")
  done <<< "$out"
  if [ "$rc" -ne 0 ]; then log "external folders could not be attached (exit $rc)"; return 1; fi
  return 0
}

run_build() {
  local reason="$1" start rc=0 secs lrc=0
  WARNINGS=(); ATTACH_WARNINGS=()
  load_config || lrc=$?
  if [ "$lrc" -ne 0 ]; then
    # A rejected configuration fails the build before anything is copied, installed or built, and the previous dist stays.
    BUILDS=$((BUILDS + 1)); FAILURES=$((FAILURES + 1)); LAST_EXIT=$lrc
    log "build FAILED (configuration exit $lrc), serving the previous dist"
    write_status failed; return 1
  fi
  # A change of the exclusion rules moves the change signature. Re-baseline it before the copy, so the edit that
  # changed the rules starts one build and not a second one.
  if [ "$RULES_KEY" != "$RULES_IN_SIG" ]; then
    PREV_SIG="$(source_sig)"; RULES_IN_SIG="$RULES_KEY"
  fi
  # Caddy keeps the serving settings it was started with; a later build that resolves other values only warns.
  if [ -z "$CUSTOM_CADDYFILE" ] && { [ "$RESOLVED_SPA" != "$SPA" ] || [ "$RESOLVED_API_UPSTREAM" != "$API_UPSTREAM" ]; }; then
    WARNINGS+=("serve settings changed: restart the container to apply")
  fi
  write_status building ',"reason":"'"$reason"'"'
  start=$(date +%s)
  if [ ! -f "$WORKSPACE/package.json" ]; then
    log "no package.json in $WORKSPACE, waiting for source"
    LAST_EXIT=null; write_status waiting; return 0
  fi
  if ! sync_source; then log "copy of $WORKSPACE to $BUILD_DIR failed"; rc=1; fi
  if [ "$rc" -eq 0 ]; then attach_external || rc=1; fi
  if [ "$rc" -eq 0 ]; then cd "$BUILD_DIR" || rc=1; fi
  if [ "$rc" -eq 0 ] && { [ ! -d node_modules ] || [ "$(deps_sig)" != "$DEPS_SIG" ]; }; then
    local icmd="$INSTALL_CMD"
    if [ -z "$icmd" ]; then
      if [ -f pnpm-lock.yaml ]; then icmd="pnpm install --frozen-lockfile"; else icmd="pnpm install"; fi
    fi
    log "install: $icmd"
    bash -c "$icmd" || rc=$?
    DEPS_SIG="$(deps_sig)"
    # Each dependency change adds packages to the pnpm store; drop the ones no project uses any more.
    if [ "$rc" -eq 0 ] && command -v pnpm >/dev/null 2>&1; then
      pnpm store prune >/dev/null 2>&1 || log "pnpm store prune failed (ignored)"
    fi
  fi
  if [ "$rc" -eq 0 ]; then
    log "build ($reason): $BUILD_CMD"
    bash -c "$BUILD_CMD" || rc=$?
  fi
  if [ "$rc" -eq 0 ]; then
    # Publish only a finished build. A failed build leaves SERVE_DIR as it was.
    rsync -a --delete "$BUILD_DIR/$DIST_DIR/" "$SERVE_DIR/" || { log "could not publish $BUILD_DIR/$DIST_DIR"; rc=1; }
  fi
  BUILDS=$((BUILDS + 1)); LAST_EXIT=$rc
  if [ "$rc" -eq 0 ]; then
    secs=$(( $(date +%s) - start ))
    # Only a successful build changes the headers: the served dist is then the one they describe.
    printf '%s' "$(date -u +%FT%TZ)" > "$BUILD_TIME_FILE.tmp" && mv "$BUILD_TIME_FILE.tmp" "$BUILD_TIME_FILE"
    printf '%s' "$secs" > "$BUILD_DURATION_FILE.tmp" && mv "$BUILD_DURATION_FILE.tmp" "$BUILD_DURATION_FILE"
    log "build ok in ${secs}s"; write_status ok
  else
    FAILURES=$((FAILURES + 1)); log "build FAILED (exit $rc), serving the previous dist"; write_status failed
  fi
}

build_loop() {
  local sig now changed_at=0 pending=0 pending_since=0 last_build
  BUILDS=0; FAILURES=0; LAST_EXIT=null; DEPS_SIG=""
  # Baseline before the first build: an edit saved during a build then shows up at the next poll.
  PREV_SIG="$(source_sig)"; RULES_IN_SIG="$RULES_KEY"
  run_build initial
  last_build=$(date +%s)
  while sleep "$POLL_INTERVAL"; do
    now=$(date +%s)
    if [ -f "$TRIGGER_FILE" ]; then
      rm -f "$TRIGGER_FILE"; run_build manual
      last_build=$(date +%s); pending=0; continue
    fi
    # A listing that fails skips this poll: a broken read is never taken for a change.
    sig="$(source_sig)" || continue
    if [ "$sig" != "$PREV_SIG" ]; then
      # Every change restarts the quiet window, so a burst of saves ends in one build.
      PREV_SIG="$sig"; changed_at=$now
      if [ "$pending" -eq 0 ]; then pending=1; pending_since=$now; fi
    fi
    [ "$pending" -eq 1 ] || continue
    [ $(( now - last_build )) -ge "$MIN_BUILD_INTERVAL" ] || continue
    [ $(( now - changed_at )) -ge "$DEBOUNCE_SECONDS" ] || [ $(( now - pending_since )) -ge "$MAX_WAIT_SECONDS" ] || continue
    run_build "source changed"
    last_build=$(date +%s); pending=0
    # No re-read of the signature here: builds write only to BUILD_DIR, so a change made during
    # this build is still seen at the next poll.
  done
}

cmd="${1:-run}"
case "$cmd" in
  rebuild) mkdir -p "$STATE_DIR" && touch "$TRIGGER_FILE" && echo "rebuild requested"; exit 0 ;;
  status)  cat "$STATUS_FILE"; exit 0 ;;
  run) ;;
  # The control node replaces the project host: no Caddy, no build loop, no project STATE_DIR setup.
  control) exec node /usr/local/lib/dev-host/control/server.mjs ;;
  *) echo "usage: dev-host [run|rebuild|status|control]" >&2; exit 2 ;;
esac

# Fail at start, not on the first build, when the registry is not an http(s) URL without credentials.
if [ -n "$NPM_REGISTRY" ]; then
  case "$NPM_REGISTRY" in
    http://*|https://*) ;;
    *) echo "[dev-host] NPM_REGISTRY must start with http:// or https://" >&2; exit 2 ;;
  esac
  case "$NPM_REGISTRY" in
    *[[:space:]]*|*://*@*) echo "[dev-host] NPM_REGISTRY must not contain whitespace or credentials" >&2; exit 2 ;;
  esac
  log "npm registry: $NPM_REGISTRY"
fi

mkdir -p "$STATE_DIR" "$SERVE_DIR"
# The serving settings are read once, here: environment first, then the workspace file, then the defaults.
# A rejected file still yields values (from the environment and defaults) and is reported by the first build.
load_config || log "workspace configuration not applied at start (see status.json); serving with the environment and defaults"
SPA="${RESOLVED_SPA:-$SPA}"
API_UPSTREAM="${RESOLVED_API_UPSTREAM:-$API_UPSTREAM}"
if [ -f "${CADDYFILE:-}" ]; then
  cp "$CADDYFILE" "$STATE_DIR/Caddyfile"; CUSTOM_CADDYFILE=1
else
  write_caddyfile
fi
BUILDS=0; FAILURES=0; LAST_EXIT=null
# Start empty: the headers stay blank until this container completes a build. The file must exist,
# or Caddy logs an error for every request.
: > "$BUILD_TIME_FILE"; : > "$BUILD_DURATION_FILE"
write_status starting

log "caddy on :$HTTP_PORT, serving $SERVE_DIR (built in $BUILD_DIR from $WORKSPACE)"
caddy run --config "$STATE_DIR/Caddyfile" --adapter caddyfile &
CADDY_PID=$!
build_loop &
LOOP_PID=$!

trap 'kill "$CADDY_PID" "$LOOP_PID" 2>/dev/null; wait; exit 0' TERM INT
# If either child dies, stop the container so the orchestrator can restart it.
wait -n "$CADDY_PID" "$LOOP_PID"
log "a child process exited, shutting down"
kill "$CADDY_PID" "$LOOP_PID" 2>/dev/null
wait
exit 1
